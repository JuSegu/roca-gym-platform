{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd frontend/roca-gym-web && npm install && npx ng build",
  "outputDirectory": "frontend/roca-gym-web/dist/roca-gym-web/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
